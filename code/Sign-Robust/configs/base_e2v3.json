{
  "schema_version": "1.0",
  "name": "SIGN E2V3 shared robustness defaults",
  "model": {
    "basis_variant": "trig_exp_v2",
    "candidate_library": {
      "L1": 50,
      "L2": 100,
      "L3": 150,
      "families": ["polynomial", "trigonometric", "exponential", "fractional", "periodic"]
    },
    "phase1": {
      "derivative": "five_point_finite_difference",
      "regression": "lasso",
      "consensus_default": "DBSCAN",
      "dbscan_min_samples": 2,
      "fallback": "global_lasso_if_no_valid_cluster"
    },
    "phase2": {
      "mask_source": "phase1_fixed_support",
      "integrator": "forward_euler",
      "coefficient_threshold": 0.0001,
      "pruning": ["magnitude", "contribution"],
      "can_add_terms": false,
      "sparse_warmup_epochs": 20
    }
  },
  "simulation": {
    "default_num_points": 1000,
    "default_dt": 0.01,
    "integrator_for_data": "rk4",
    "benchmark_systems": ["kuramoto", "sis", "michaelis_menten", "fhn", "hr", "rossler"],
    "dimensions": {"kuramoto": 1, "sis": 1, "michaelis_menten": 1, "fhn": 2, "hr": 3, "rossler": 3},
    "network_defaults": {
      "scale_free": {"generator": "barabasi_albert_graph", "attachment_m": 3, "node_count_range": [10, 100000]},
      "small_world": {"generator": "newman_watts_strogatz_graph", "k": 3, "p": 0.3, "node_count_range": [10, 100000]}
    },
    "dynamics_parameters": {
      "kuramoto": {"omega": 0.3, "coupling_strength": 1.0, "initial_state": "Uniform(0,10)"},
      "sis": {"beta": 1.0, "gamma": 1.0, "initial_state": "Uniform(0,0.5)"},
      "michaelis_menten": {"alpha": 1.0, "beta": 1.0, "h": 1.0},
      "fhn": {"a": 0.5, "b": 0.3, "c": 1.0, "v": 1.0, "I_ext": 1.0, "baseline_coupling_strength": 0.1, "initial_state": "Uniform(0,1)"},
      "hr": {"epsilon": 0.5, "a": 3.0, "b": 5.0, "c": 1.0, "mu": 0.01, "s": 4.0, "I": 3.24, "x_rest": -1.6, "initial_state": "Uniform(0,1)"},
      "rossler": {"epsilon": 0.5, "a": 0.2, "b": 0.2, "c": 6.0, "initial_state": "Uniform(0,1)"}
    }
  },
  "reproducibility": {
    "seed_policy": "explicit_integer_seed",
    "no_seed_filtering": true,
    "no_smoothing": true
  }
}
